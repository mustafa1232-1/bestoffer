# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
*.xcuserstate
!/ios/Podfile
!/ios/Podfile.lock
!/ios/Runner/
!/ios/Flutter/
!/ios/Runner.xcodeproj/
!/ios/Runner.xcworkspace/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend local artifacts
/backend/node_modules/
/backend/.env
/backend/.env.test
/backend/uploads/
/tmp_r2_test/

# Firebase secrets (do not commit)
.firebase/
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/backend/deploy/*service-account*.json

# Android signing secrets (do not commit)
*.jks
*.keystore
key.properties
android/key.properties
keystores/
**/key.properties
**/*.jks
**/*.keystore

# --- Build & QA artifacts (machine-generated, never commit) ---
/qa_artifacts/
/backend/qa_artifacts/**/qa-role-matrix.json
/dist/
/backend/.qa_pg/
/backend/.tmp_pg*
**/.cxx/
/overflow_debug.txt
/backend/tmp_*

# Local backup files
*.backup.*
*.backup

# Local scratch/diagnostic scripts (never commit)
backend/tmp/
