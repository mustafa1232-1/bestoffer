NODE_ENV=production
APP_ENV=production
APP_VERSION=
GIT_COMMIT_SHA=
PORT=3000
HOST=0.0.0.0
JSON_BODY_LIMIT=10mb
REQUEST_TIMEOUT_MS=30000
LOG_HTTP_REQUESTS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
RATE_LIMIT_AUTH_MAX_REQUESTS=40
SUPER_ADMIN_USER_ID=1
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=07746515247
SUPER_ADMIN_PIN=1998

# Local Postgres inside docker-compose
DATABASE_URL=postgresql://bestoffer:replace_with_strong_password@postgres:5432/bestoffer
DATABASE_PUBLIC_URL=

# Very important: set a long random value
JWT_SECRET=replace_with_long_random_secret
JWT_SECRET_PREVIOUS=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL=7d

# Runs SQL files from backend/sql once per file
RUN_SQL_MIGRATIONS=true

# In production keep this false
DEV_SEED_ADMIN=false

# CORS (comma-separated in production)
CORS_ORIGINS=*

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_BACKEND=
SENTRY_PROJECT_FLUTTER=
SENTRY_SERVICE_NAME=maslaki-backend

# Datadog
DD_API_KEY=
DD_APP_KEY=
DD_SITE=
DD_SERVICE=maslaki-backend
DD_ENV=
DD_VERSION=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_TRIAGE=
OPENAI_MODEL_DEEP_ANALYSIS=
OPENAI_MODEL_CODE_TASKS=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Railway
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# Supabase Realtime delivery (Railway remains source of truth)
SUPABASE_REALTIME_ENABLED=false
SUPABASE_REALTIME_MODE=dual
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_REALTIME_OUTBOX_MAX_ATTEMPTS=8
SUPABASE_REALTIME_OUTBOX_BASE_DELAY_MS=1000

# Ops guardrails
OPS_API_KEY=
OPS_ENABLE_AI_ANALYSIS=true
OPS_ENABLE_AUTO_RESTART=false
OPS_ENABLE_AUTO_ROLLBACK=false
OPS_ENABLE_FEATURE_FLAG_DISABLE=false
OPS_REQUIRE_SECOND_APPROVAL_FOR_CRITICAL=true

# Feature flags
FEATURE_FLAG_PROVIDER=
UNLEASH_URL=
UNLEASH_API_TOKEN=

# Firebase Cloud Messaging (for push outside app)
# Option 0 (recommended for Railway): base64(JSON)
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
#
# Option 1: full JSON in one variable
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
#
# Option 2: split variables
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
