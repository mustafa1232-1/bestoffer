{
  "name": "bismayah-store-api",
  "version": "1.0.0",
  "description": "Bismayah Store Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/start.js",
    "start:app": "node src/server.js",
    "start:ops": "node src/ops-server.js",
    "migrate:sql": "node src/scripts/migrate.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "superadmin:enforce-single": "node src/scripts/enforceSingleSuperAdmin.js",
    "reset:db:keep-super-admin": "node src/scripts/resetDbKeepSuperAdmin.js",
    "firebase:env": "node deploy/firebase-env-from-json.mjs",
    "security:check": "node src/scripts/securitySelfCheck.js",
    "security:runtime:check": "node src/scripts/securityRuntimeCheck.js",
    "permissions:check": "node src/scripts/rolePermissionCheck.js",
    "flow:check": "node --env-file=.env.test src/scripts/flowIntegrityCheck.js",
    "audit:store-category-separation": "node src/scripts/auditStoreCategorySeparation.js",
    "e2e:order:check:local": "node --env-file=.env.test src/scripts/orderE2ECheck.js",
    "e2e:order:check": "node src/scripts/orderE2ECheck.js",
    "e2e:services:check": "node src/scripts/servicesE2ECheck.js",
    "e2e:taxi:check": "node src/scripts/taxiE2ECheck.js",
    "e2e:community:check": "node src/scripts/communityE2ECheck.js",
    "e2e:jobs:check": "node src/scripts/jobsE2ECheck.js",
    "e2e:pharmacy:check": "node src/scripts/pharmacyE2ECheck.js",
    "auth:session:push:check": "node src/scripts/authSessionPushE2ECheck.js",
    "e2e:financial:check": "node src/scripts/financialSettlementsE2ECheck.js",
    "e2e:new-streams:check": "node src/scripts/newStreamsE2ECheck.js",
    "test": "node --env-file=.env.test --test \"src/tests/**/*.test.js\"",
    "verify:release:local": "npm test && npm run flow:check",
    "realtime:runtime:check": "node src/scripts/realtimeRuntimeCheck.js",
    "verify:release:runtime": "node src/scripts/verifyReleaseRuntime.js",
    "guard:text": "node src/scripts/textEncodingGuard.js",
    "verify:backend": "npm run security:check && npm run flow:check && npm run e2e:order:check && npm run e2e:taxi:check && npm run e2e:community:check && npm run e2e:services:check && npm run e2e:jobs:check && npm run e2e:pharmacy:check",
    "load:fixtures:seed": "node src/scripts/seedLoadFixtures.js",
    "load:fixtures:cleanup": "node src/scripts/cleanupLoadFixtures.js",
    "load:burst": "node src/scripts/loadSuiteBurst.js",
    "load:live": "node src/scripts/liveModuleStress.js",
    "load:sse": "node src/scripts/sseStreamStress.js",
    "load:matrix": "node src/scripts/fullAppLoadMatrix.js",
    "e2e:store-catalog-coupon:check": "node src/scripts/storeCatalogCouponE2ECheck.js",
    "guard:removed-features": "node src/scripts/removedFeaturesGuard.js",
    "realtime:outbox:worker": "node src/scripts/realtimeOutboxWorker.js"
  },
  "keywords": [],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@openfeature/core": "^1.10.0",
    "@openfeature/server-sdk": "^1.21.0",
    "@sentry/node": "^9.31.0",
    "@supabase/supabase-js": "^2.108.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dd-trace": "^5.70.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "tesseract.js": "^5.1.1",
    "ws": "^8.18.3"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "brace-expansion": "^2.0.3",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.8.0",
    "node-forge": "^1.4.0",
    "path-to-regexp": "^0.1.13",
    "protobufjs": "^7.6.1",
    "qs": "^6.15.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
